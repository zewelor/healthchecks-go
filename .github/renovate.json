{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions updates, including major versions",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "automerge": true
    },
    {
      "description": "Group Go versions in the module, build image and CI",
      "matchDepNames": ["go", "docker.io/library/golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Keep the Go module directive up to date",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
